# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.tsbuildinfo

# phase execution outputs
phases/**/phase*-output.json
phases/**/step*-output.json

# drive module uploads (user-uploaded files)
/uploads

.claude/
.serena/

# local tool outputs
graphify-out/
.playwright-mcp/
.superpowers/

# personal notes
PROJECT.md
