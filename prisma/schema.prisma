generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  ownedProjects  Project[]       @relation("ProjectOwner")
  projectMembers ProjectMember[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  uploadedFiles  DriveFile[]     @relation("FileUploader")
  ownedFolders   DriveFolder[]   @relation("FolderOwner")
  portfolios     Portfolio[]     @relation("PortfolioOwner")
  memos          Memo[]          @relation("MemoOwner")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(IN_PROGRESS)
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner           User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  members         ProjectMember[]
  tasks           Task[]
  milestones      Milestone[]
  projectUrls     ProjectUrl[]
  projectAccounts ProjectAccount[]
  projectDbs      ProjectDb[]
  memos           Memo[]
}

model ProjectUrl {
  id        String   @id @default(cuid())
  projectId String
  tags      Json
  name      String
  domain    String
  username  String?
  password  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectAccount {
  id        String   @id @default(cuid())
  projectId String
  tags      Json
  ip        String
  username  String
  password  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectDb {
  id        String   @id @default(cuid())
  projectId String
  tags      Json
  ip        String
  username  String
  password  String?
  port      String?
  dbName    String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  projectId String
  userId    String
  role      MemberRole @default(DEVELOPER)
  joinedAt  DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  startDate   DateTime?
  dueDate     DateTime
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DriveFolder {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User          @relation("FolderOwner", fields: [ownerId], references: [id])
  parent    DriveFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  DriveFolder[] @relation("FolderTree")
  files     DriveFile[]
  portfolio Portfolio?    @relation("PortfolioFolder")
}

model DriveFile {
  id           String   @id @default(cuid())
  name         String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  uploaderId   String
  folderId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploader               User             @relation("FileUploader", fields: [uploaderId], references: [id])
  folder                 DriveFolder?     @relation(fields: [folderId], references: [id])
  thumbnailForPortfolios Portfolio[]      @relation("PortfolioThumbnail")
  portfolioImages        PortfolioImage[]
}

model Portfolio {
  id              String   @id @default(cuid())
  title           String
  description     String?    @db.Text
  techSpecs       Json
  ownerId         String
  driveFolderId   String   @unique
  thumbnailFileId String?
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner         User             @relation("PortfolioOwner", fields: [ownerId], references: [id])
  driveFolder   DriveFolder      @relation("PortfolioFolder", fields: [driveFolderId], references: [id])
  thumbnailFile DriveFile?       @relation("PortfolioThumbnail", fields: [thumbnailFileId], references: [id], onDelete: SetNull)
  links         PortfolioLink[]
  images        PortfolioImage[]

  @@index([ownerId])
}

model PortfolioLink {
  id          String           @id @default(cuid())
  portfolioId String
  type        PortfolioUriType @default(OTHER)
  label       String?
  url         String
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model PortfolioImage {
  id          String   @id @default(cuid())
  portfolioId String
  fileId      String   @unique
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  file      DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Memo {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  ownerId   String
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation("MemoOwner", fields: [ownerId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([projectId])
  @@index([title])
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum MemberRole {
  PM
  DEVELOPER
  VIEWER
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum PortfolioUriType {
  GITHUB
  PRODUCTION
  OTHER
}
