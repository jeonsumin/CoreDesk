generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  ownedProjects  Project[]       @relation("ProjectOwner")
  projectMembers ProjectMember[]
  assignedTasks  TaskAssignee[]
  createdTasks   Task[]          @relation("TaskCreator")
  uploadedFiles  DriveFile[]     @relation("FileUploader")
  ownedFolders   DriveFolder[]   @relation("FolderOwner")
  portfolios     Portfolio[]     @relation("PortfolioOwner")
  memos          Memo[]          @relation("MemoOwner")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  // 이슈 키 접두어 (예: BB-CIC-WEB → BB-CIC-WEB-6). 기존 프로젝트는 scripts/migrate-issue-board.cjs가 채운다
  key         String?       @unique
  // 프로젝트별 이슈 번호 발급 카운터
  issueSeq    Int           @default(0)
  description String?
  status      ProjectStatus @default(IN_PROGRESS)
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner           User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  members         ProjectMember[]
  tasks           Task[]
  projectUrls     ProjectUrl[]
  projectAccounts ProjectAccount[]
  projectDbs      ProjectDb[]
  memos           Memo[]
}

model ProjectUrl {
  id        String   @id @default(cuid())
  projectId String
  tags      Json
  name      String
  domain    String
  username  String?
  password  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectAccount {
  id        String   @id @default(cuid())
  projectId String
  tags      Json
  ip        String
  username  String
  password  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectDb {
  id        String   @id @default(cuid())
  projectId String
  tags      Json
  ip        String
  username  String
  password  String?
  port      String?
  dbName    String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  projectId String
  userId    String
  role      MemberRole @default(DEVELOPER)
  joinedAt  DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
}

// 보드의 이슈. 에픽도 type=EPIC 인 Task 이며 같은 번호 체계를 쓴다
model Task {
  id          String     @id @default(cuid())
  projectId   String
  number      Int?
  type        IssueType  @default(TASK)
  epicId      String?
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epic      Task?          @relation("EpicIssues", fields: [epicId], references: [id], onDelete: SetNull)
  issues    Task[]         @relation("EpicIssues")
  createdBy User?          @relation("TaskCreator", fields: [createdById], references: [id])
  assignees TaskAssignee[]

  @@unique([projectId, number])
  @@index([epicId])
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
  @@index([userId])
}

model DriveFolder {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  parentId  String?
  rootId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User                    @relation("FolderOwner", fields: [ownerId], references: [id])
  parent      DriveFolder?            @relation("FolderTree", fields: [parentId], references: [id])
  children    DriveFolder[]           @relation("FolderTree")
  files       DriveFile[]
  portfolio   Portfolio?              @relation("PortfolioFolder")
  permissions DriveFolderPermission[]

  @@index([rootId])
}

model DriveFolderPermission {
  folderId String
  role     Role
  access   MenuAccess

  folder DriveFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@id([folderId, role])
}

model DriveFile {
  id           String   @id @default(cuid())
  name         String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  uploaderId   String
  folderId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploader               User             @relation("FileUploader", fields: [uploaderId], references: [id])
  folder                 DriveFolder?     @relation(fields: [folderId], references: [id])
  thumbnailForPortfolios Portfolio[]      @relation("PortfolioThumbnail")
  portfolioImages        PortfolioImage[]
}

model Portfolio {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  techSpecs       Json
  ownerId         String
  driveFolderId   String   @unique
  thumbnailFileId String?
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner         User             @relation("PortfolioOwner", fields: [ownerId], references: [id])
  driveFolder   DriveFolder      @relation("PortfolioFolder", fields: [driveFolderId], references: [id])
  thumbnailFile DriveFile?       @relation("PortfolioThumbnail", fields: [thumbnailFileId], references: [id], onDelete: SetNull)
  links         PortfolioLink[]
  images        PortfolioImage[]

  @@index([ownerId])
}

model PortfolioLink {
  id          String           @id @default(cuid())
  portfolioId String
  type        PortfolioUriType @default(OTHER)
  label       String?
  url         String
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model PortfolioImage {
  id          String   @id @default(cuid())
  portfolioId String
  fileId      String   @unique
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  file      DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Memo {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  ownerId   String
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation("MemoOwner", fields: [ownerId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([projectId])
  @@index([title])
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum MemberRole {
  PM
  DEVELOPER
  VIEWER
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum IssueType {
  EPIC
  STORY
  TASK
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum PortfolioUriType {
  GITHUB
  PRODUCTION
  OTHER
}

enum MenuType {
  GROUP
  PAGE
  LINK
}

enum MenuStatus {
  ACTIVE
  PREPARING
}

enum MenuAccess {
  NONE
  READ
  WRITE
}

model Menu {
  id        String     @id @default(cuid())
  title     String
  type      MenuType
  path      String?    @unique
  icon      String
  section   String?
  parentId  String?
  sortOrder Int
  status    MenuStatus @default(ACTIVE)
  isSystem  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  parent      Menu?            @relation("MenuTree", fields: [parentId], references: [id])
  children    Menu[]           @relation("MenuTree")
  permissions MenuPermission[]
}

model MenuPermission {
  menuId String
  role   Role
  access MenuAccess
  menu   Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([menuId, role])
}
