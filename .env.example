APP_PORT=3000

DATABASE_URL="mysql://coredesk:replace-with-strong-database-password@localhost:3306/coredesk"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-auth-secret"

# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="base64:REPLACE_WITH_32_BYTE_BASE64_KEY"

# Optional. Defaults to ./uploads/drive under the project root.
# Use an absolute path for storage outside the project directory.
# DRIVE_UPLOAD_ROOT="/var/lib/coredesk/uploads"

# Docker only. Host directory or named volume source mounted at /app/uploads.
# Leave empty to use the uploads_data Docker named volume.
# DRIVE_UPLOAD_HOST_PATH="/srv/coredesk/uploads"

# Docker only. auto uses migrate deploy for PostgreSQL and db push for MySQL.
# Set to skip if database schema is managed outside the app container.
PRISMA_DB_SYNC=auto
